# ── digitalhaptics.dev environment ───────────────────────────────────
# Copy to .env.local for local work. Mirror every value into Cloudflare
# Pages → Settings → Environment variables, for Production AND Preview,
# or the deployed site will behave differently from your machine.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the JavaScript the
# browser downloads. Never put a secret in a NEXT_PUBLIC_ variable.

# ── Feature flags (PLAN §2.1) ───────────────────────────────────────
# Read ONLY through lib/flags.ts. Only the exact string "true" turns a
# flag on; missing or anything else is off.
#
#                         local dev (opt-in)   Preview   Production
#   FEATURE_AUTOMATIONS        true             false      false
#   FEATURE_AUTOMATIONS_DEMO   true             false      false
#   FEATURE_VOICE              false            false      false
#
# They are build-time values: change one, then rebuild/redeploy.
FEATURE_AUTOMATIONS=false
FEATURE_AUTOMATIONS_DEMO=false
FEATURE_VOICE=false

# ── Preview mode ────────────────────────────────────────────────────
# "1" forces a preview build: noindex everywhere, robots.txt disallow,
# empty sitemap. Not needed on Cloudflare: every branch except main is
# detected automatically (scripts/is-preview.mjs). Never set it in
# Production.
NEXT_PUBLIC_PREVIEW=

# ── Cloudflare Turnstile (public site key) ──────────────────────────
# The secret half (TURNSTILE_SECRET_KEY) is a Pages Function secret set
# in the dashboard, never here. Wired up in Phase 4.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Intake endpoint secrets (Phase 4) ───────────────────────────────
# Set as ENCRYPTED variables on the Pages project, not in .env.local
# for the static build. Listed so they are documented in one place;
# scripts/harden.mjs fails the build if any value reaches out/.
#
#   RESEND_API_KEY            lead notification email
#   TURNSTILE_SECRET_KEY      server-side Turnstile verification
#   AUTOMATIONS_WEBHOOK_URL   speed-to-lead webhook (🚩 FEATURE_AUTOMATIONS)
#   EXPORT_TOKEN              bearer token for the leads CSV export
