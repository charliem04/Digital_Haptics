{
  "extends": "next/core-web-vitals",
  "overrides": [
    {
      "files": ["app/**/*.{ts,tsx}", "components/**/*.{ts,tsx}", "data/**/*.ts"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "MemberExpression[object.name='process'][property.name='env']",
            "message": "Components never read process.env (PLAN §2.1). Use `flags` from lib/flags.ts or a value from site.config.ts."
          }
        ]
      }
    }
  ]
}
