// Cloudflare Worker for digitalhaptics.dev (decision D1, revised
// 2026-11-03: a Worker with static assets instead of Pages).
//
// `npm run build` writes the static export to out/. The asset server
// answers every path except /api/*, which runs worker/index.ts first
// (intake form, conversion events, the flagged demo).
//
// Secrets are NOT here. Set them in the dashboard (Worker → Settings →
// Variables and Secrets) or with `npx wrangler secret put NAME`:
//   RESEND_API_KEY, TURNSTILE_SECRET_KEY,
//   🚩 AUTOMATIONS_WEBHOOK_URL, AUTOMATIONS_WEBHOOK_SECRET
// docs/SETUP.md §3 walks through each.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the dashboard. Workers Builds
  // overrides it with the dashboard name anyway.
  "name": "digitalhaptics",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Only the API runs code; every page is a plain file.
    "run_worker_first": ["/api/*"],
    // Unknown paths get out/404.html with a 404 status, which is how a
    // flagged route stays a real 404 (PLAN §2.1).
    "not_found_handling": "404-page",
    // Matches next.config.mjs trailingSlash: /privacy → /privacy/.
    "html_handling": "auto-trailing-slash",
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },

  // ── Production bindings ─────────────────────────────────────────
  "vars": {
    "SITE_ENV": "production",
    // Lead notifications. FROM must be on a domain verified in Resend.
    "LEAD_NOTIFY_TO": "charles@digitalhaptics.dev",
    "LEAD_NOTIFY_FROM": "Digital Haptics <leads@digitalhaptics.dev>",
  },
  "d1_databases": [
    {
      // IDs are pinned so a deploy can never create a second database
      // and strand the leads in the first. Not secrets: they only work
      // inside this Cloudflare account. The table is created on first
      // use (worker/db.ts), so there is no migration step.
      "binding": "DB",
      "database_name": "digitalhaptics-leads",
      "database_id": "dc861fa5-c152-4904-9193-18e536d1771f",
    },
  ],
  "ratelimits": [
    {
      // 10 submissions per minute per IP for intake and demo. A
      // backstop behind Turnstile, not the main defence.
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "digitalhaptics_events" }],
  // Retry undelivered lead emails (and 🚩 webhooks) every 15 minutes.
  "triggers": { "crons": ["*/15 * * * *"] },

  // ── Preview bindings ────────────────────────────────────────────
  // `wrangler preview` (every non-main branch) uses these instead.
  // A separate database, so test submissions never reach the real
  // leads table (REFACTOR_AUDIT §9), and a separate events dataset.
  "previews": {
    "vars": {
      "SITE_ENV": "preview",
      "LEAD_NOTIFY_TO": "charles@digitalhaptics.dev",
      "LEAD_NOTIFY_FROM": "Digital Haptics <leads@digitalhaptics.dev>",
    },
    // `wrangler preview` won't create a database, so this one was made
    // in the dashboard and its ID pinned here.
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "digitalhaptics-leads-preview",
        "database_id": "68201293-423c-4c82-91ab-0eab9f888156",
      },
    ],
    "ratelimits": [
      { "name": "LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    ],
    "analytics_engine_datasets": [
      { "binding": "EVENTS", "dataset": "digitalhaptics_events_preview" },
    ],
  },
}
