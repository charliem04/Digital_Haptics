{
  "name": "digitalhaptics-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/worker-flags.mjs && next build && node scripts/csp.mjs && node scripts/seo.mjs && node scripts/routes.mjs --check && node scripts/preview-headers.mjs --if-preview && node scripts/harden.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "node scripts/worker-flags.mjs && tsc --noEmit && tsc -p worker --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --experimental-strip-types --no-warnings --test \"worker/test/*.test.ts\"",
    "worker:dev": "node scripts/worker-flags.mjs && wrangler dev",
    "preview:build": "node scripts/preview-build.mjs",
    "preview:deploy": "npm run preview:build && wrangler versions upload --preview-alias preview",
    "check": "node scripts/check.mjs app components lib content site.config.ts",
    "routes": "node scripts/routes.mjs",
    "harden": "node scripts/harden.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "gray-matter": "4.0.3",
    "next": "^14.2.15",
    "next-mdx-remote": "6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "prettier": "3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5",
    "wrangler": "4.157.0"
  }
}
