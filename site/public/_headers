# Response headers, served by Workers static assets.
# Keep ONE /* rule: when several rules share a pattern, only the last
# applies. scripts/csp.mjs and preview-headers.mjs add their headers
# inside this block (scripts/headers-file.mjs).

/*
  # Don't let a browser guess a MIME type we didn't send.
  X-Content-Type-Options: nosniff
  # Send the origin to other sites, the full path only to ourselves.
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing here should ever be framed by anyone else. The CSP that
  # scripts/csp.mjs generates carries frame-ancestors too; this stays as
  # the older-browser equivalent. Two Content-Security-Policy headers on
  # one path are enforced as an intersection, which is confusing to
  # reason about, so this file no longer sets one — the generated policy
  # owns CSP entirely.
  X-Frame-Options: DENY
  # Features this site has no business asking for.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # After one visit over HTTPS, the browser refuses plain HTTP for a
  # year. Belt and braces on this domain: the whole .dev top-level
  # domain is on the browsers' HSTS preload list, so every
  # *.digitalhaptics.dev host is HTTPS-only before anyone visits. That
  # also means includeSubDomains and preload would add nothing here.
  Strict-Transport-Security: max-age=31536000

# Next's build output is content-hashed, so a given URL's bytes never
# change. Cache it hard and forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images are NOT hashed — replacing one reuses its filename. A day of
# browser cache with revalidation after that, so a swapped image appears
# within a day rather than never.
/brand/*
  Cache-Control: public, max-age=86400, must-revalidate

/icon.png
  Cache-Control: public, max-age=86400, must-revalidate

# The Content-Security-Policy is NOT here — scripts/csp.mjs generates it
# at build time and adds it to the /* rule in the copy of this file in out/, after
# checking every origin the build references against it.
#
# That script also fails the build if the output references an origin
# the policy does not cover, so adding an embed forces a decision rather
# than silently escaping the policy.
