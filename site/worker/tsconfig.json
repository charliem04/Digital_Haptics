{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] }
  },
  // Tests run under node --test, not in a Worker; Node's own type
  // stripping runs them, and their assertions are the check.
  "exclude": ["./test/**"],
  "include": [
    "./**/*.ts",
    "../lib/intake-rules.ts",
    "../data/intake.ts",
    "../data/services.ts",
    "../data/demo.ts"
  ]
}
